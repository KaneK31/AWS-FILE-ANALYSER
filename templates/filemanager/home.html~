<!DOCTYPE html>
<html>
<head>
    <title>File Version Manager</title>
</head>
<body>
    <h1>📂 Welcome to File Version Manager</h1>

    {% if user.is_authenticated %}
        <p>Hello, {{ user.username }}!</p>
        <p><a href="{% url 'upload' %}">📤 Upload a File</a></p>
    <form action="{% url 'logout' %}" method="post">
        {% csrf_token %}
        <button type="submit">🚪 Logout</button>
    </form>
    <form action="{% url 'select_file' %}" method="get">
    <button type="submit">📄 View My Files</button>
    </form>

    {% else %}
        <p>You are not logged in.</p>
        <p><a href="{% url 'login' %}">🔐 Login</a> or <a href="{% url 'signup' %}">📝 Sign Up</a></p>
    {% endif %}

    <hr>
    <p>This project allows users to upload files to S3, track version history, and download any previous version.</p>
</body>
</html>
