{% extends 'filemanager/base.html' %}

{% block title %}Analysis Results{% endblock %}

{% block content %}
<h2 class="mb-3">📊 Analysis of {{ filename }}</h2>

<ul class="list-group mb-4">
    <li class="list-group-item"><strong>Rows:</strong> {{ shape.0 }}</li>
    <li class="list-group-item"><strong>Columns:</strong> {{ shape.1 }}</li>
    <li class="list-group-item"><strong>Column Names:</strong> {{ columns|join:", " }}</li>
</ul>

<h4>🔍 Preview of First Rows</h4>
<div class="table-responsive">
    {{ preview|safe }}
</div>


<form method="post" action="{% url 'analysis_view_col' %}">
    {% csrf_token %}
    <input type="hidden" name="file_key" value="{{ user.username  }}/{{ filename }}">
    <label for="column">Choose column:</label>
    <select name="column">
        {% for col in columns %}
        <option value="{{ col }}">{{ col }}</option>
        {% endfor %}
    </select>
    <button type="submit">Analyze</button>
</form>



{% endblock %}
